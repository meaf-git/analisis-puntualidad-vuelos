table 'main vuelos_denormalizados'
	lineageTag: 6245f576-8986-49ad-b0aa-81b982ee37e8

	measure 'Vuelos con salida registrada' =
			
			CALCULATE(
			    [Total Vuelos Analizados],
			    'main vuelos_denormalizados'[retraso_salida_min] > 0
			)
		lineageTag: 782b1fe1-6b75-4115-b0bb-ddd0196a7517

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promedio Demora Salida' = AVERAGE('main vuelos_denormalizados'[demora_salida_15])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: fdb90c9e-a683-46eb-a00c-6f83c5b3fd9a

		changedProperty = IsHidden

	measure 'Vuelos Retrasados Salida' =
			
			CALCULATE(
			    [Total Vuelos Analizados],
			    'main vuelos_denormalizados'[retraso_salida_min] > 0
			)
		formatString: 0
		lineageTag: 9503ab3d-fa6a-446a-977b-d7d5a3ee0361

		changedProperty = IsHidden

	measure '% Vuelos Retrasados' =
			
			DIVIDE(
			    [Vuelos Retrasados Salida],
			    [Total Vuelos Analizados],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 02982008-3cdd-45e2-98a0-803bd175ab93

		changedProperty = IsHidden

	measure 'Promedio Retraso Salida (Min)' =
			
			CALCULATE(
			    AVERAGE('main vuelos_denormalizados'[retraso_salida_min]),
			    'main vuelos_denormalizados'[estado] = "Arrived",
			    'main vuelos_denormalizados'[retraso_salida_min] > 0
			)
		formatString: 0.000
		lineageTag: 5bb55bc9-fdbc-43b0-8362-34a5d8aff76a

		changedProperty = IsHidden

	measure 'Magnitud Retraso Real' =
			CALCULATE(
			    AVERAGE('main vuelos_denormalizados'[retraso_salida_min]),
			    'main vuelos_denormalizados'[retraso_salida_min] > 0
			)
		lineageTag: 4d99d701-2373-4b21-b8a7-6a3d5ede9821

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clasificación Retraso'
		lineageTag: 66671827-903a-4731-820e-ce97d1d8cb60

		changedProperty = IsHidden

	measure 'Promedio Retraso Llegada (Min)' =
			
			CALCULATE(
			    AVERAGE('main vuelos_denormalizados'[retraso_llegada_min]),
			    'main vuelos_denormalizados'[estado] = "Arrived",
			    'main vuelos_denormalizados'[retraso_llegada_min] > 0
			)
		formatString: 0.000
		lineageTag: acd3893e-99f5-4e24-a21f-73d91b5b5ce2

		changedProperty = IsHidden

	measure 'Total Vuelos Analizados' =
			
			DISTINCTCOUNT('main vuelos_denormalizados'[vuelo_id])
		formatString: 0
		lineageTag: 9a2ab7ac-29b1-4447-b57f-85a7a37837a6
		dataCategory: Uncategorized

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% Proporcion_Analizada' = DIVIDE([Total Vuelos Analizados],33121, 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1f20db6d-9ef2-4a1c-aca9-7f26adef8380

		changedProperty = IsHidden

	measure '% Cumplimiento Global' = 1 - [% Vuelos Retrasados]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 77c1c747-47c3-46f8-b950-59365dc2405f

		changedProperty = IsHidden

	measure 'Vuelos Unicos Retraso' =
			
			CALCULATE(
			    DISTINCTCOUNT('main vuelos_denormalizados'[vuelo_id]),
			    NOT(ISBLANK('main vuelos_denormalizados'[retraso_salida_min]))
			)
		formatString: 0.0000
		lineageTag: 7fed85ba-53df-4e61-8450-0fc281485e33

		changedProperty = IsHidden

	measure Salidas_Tardias =
			
			CALCULATE(
			    DISTINCTCOUNT('main vuelos_denormalizados'[vuelo_id]),
			    'main vuelos_denormalizados'[retraso_salida_min] > 0
			)
		formatString: 0
		lineageTag: d13dc0f3-9ca6-4e12-85d5-06382630c596

		changedProperty = IsHidden

	measure 'Total Vuelos' = COUNTROWS('main vuelos_denormalizados')
		formatString: 0
		lineageTag: ffd4f7ae-d327-4db0-abef-3384b3521534

		changedProperty = IsHidden

	measure 'Cant. Vuelos con Retraso Salida' = CALCULATE(COUNTROWS('main vuelos_denormalizados'), 'main vuelos_denormalizados'[demora_salida_15] >= 15)
		formatString: 0
		lineageTag: bfc7e35b-411b-41b8-b782-ba5e7f9e6e0f

		changedProperty = IsHidden

	measure '% Frecuencia Retraso Salida' = DIVIDE([Cant. Vuelos con Retraso Salida], [Total Vuelos], 0)
		lineageTag: 85086680-bcec-4b71-9031-22ce68ee8e83

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cant. Vuelos con Retraso Llegada' = CALCULATE(COUNTROWS('main vuelos_denormalizados'), 'main vuelos_denormalizados'[demora_llegada_15] >= 15)
		formatString: 0
		lineageTag: 2f07bdb8-e6a4-4ff8-bb83-415c5dc40e39

		changedProperty = IsHidden

	measure 'Promedio Minutos Retraso Salida' = DIVIDE([Total Minutos Retraso Salida], [Total Vuelos], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
